#!/usr/bin/env python3
"""Preserve a CLI's status/stderr and summarize its complete stdout for an oracle.

Usage: oracle-stream /path/to/binary [CLI arguments...]
This adapter avoids multi-gigabyte temporary animation files. It is for
correctness checks only; performance measurements invoke the binary directly.
"""
import hashlib
import subprocess
import sys
import tempfile

digest = hashlib.sha256()
length = 0
with tempfile.TemporaryFile() as errors:
    process = subprocess.Popen(sys.argv[1:], stdin=sys.stdin.buffer,
                               stdout=subprocess.PIPE, stderr=errors)
    with process.stdout:
        while chunk := process.stdout.read(1024 * 1024):
            length += len(chunk)
            digest.update(chunk)
    status = process.wait()
    errors.seek(0)
    while chunk := errors.read(65536):
        sys.stderr.buffer.write(chunk)

print(length, digest.hexdigest())
raise SystemExit(status if status >= 0 else 128 - status)
